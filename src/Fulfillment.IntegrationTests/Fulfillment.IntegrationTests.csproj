<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integration tests against a real SQL Server: a Testcontainers container locally (Docker
       required), or the server named by FULFILLMENT_TEST_SQL_SERVER (CI service containers). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Test names follow Unit_Condition_Result (constitution 13.3). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fulfillment.OrderApi\Fulfillment.OrderApi.csproj" />
    <ProjectReference Include="..\Fulfillment.ClientSimulator\Fulfillment.ClientSimulator.csproj" />
    <ProjectReference Include="..\Fulfillment.InventoryService\Fulfillment.InventoryService.csproj" Aliases="inventory" />
    <ProjectReference Include="..\Fulfillment.PaymentProviderSimulator\Fulfillment.PaymentProviderSimulator.csproj" Aliases="provider" />
    <ProjectReference Include="..\Fulfillment.PaymentService\Fulfillment.PaymentService.csproj" Aliases="payment" />
    <ProjectReference Include="..\Fulfillment.ShippingService\Fulfillment.ShippingService.csproj" Aliases="shipping" />
    <!-- Aliased: the inventory service has a public Program too (the order API host uses the global one). -->
  </ItemGroup>
</Project>
