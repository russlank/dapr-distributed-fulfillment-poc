<Project>
  <!-- Central package versions (constitution 7.2). Pinned 2026-11-18; each version was published
       at least two weeks earlier. Projects reference packages without a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dapr .NET SDK 1.19.0 (2026-10-22); runtime images are 1.19.1. -->
    <PackageVersion Include="Dapr.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="Dapr.Actors.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="Dapr.Workflow" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Overrides a vulnerable transitive 9.0.4 from SqlClient. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <!-- EF Core 10.0.14 (2026-10-25), same servicing release as the aspnet:10.0.14 runtime image. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <!-- Test-only: host the Order API in-process (10.0.14), SQL Server containers (4.16.0, 2026-10-08). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
