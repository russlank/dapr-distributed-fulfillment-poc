<Project>
  <!-- Shared build settings for every project under src/ (C# solution constitution 7.1). -->
  <PropertyGroup>
    <AppTargetFramework>net10.0</AppTargetFramework>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
    <!-- No InvariantGlobalization: Microsoft.Data.SqlClient throws NotSupportedException in invariant mode. -->
    <Company>Digixoil</Company>
    <Product>Dapr Distributed Fulfillment PoC</Product>
    <Copyright>Copyright (c) 2026 Russlan Kafri</Copyright>
    <!-- One version family; the tag v<VersionPrefix> marks a verified milestone. A tagged release
         has an empty VersionSuffix (constitution 8.2: suffixes are for prerelease channels);
         development after a release uses the next prefix with a suffix. -->
    <VersionPrefix>0.5.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>0.5.0</AssemblyVersion>
    <FileVersion>0.5.0</FileVersion>
    <!-- Marker checked by Directory.Build.targets. -->
    <RepoBuildPropsImported>true</RepoBuildPropsImported>
  </PropertyGroup>

  <!-- Compile-time feature flag (constitution 7.3.1): failure-injection points exist only in
       drill builds (-p:EnableFailpoints=true); the symbol is added in Directory.Build.targets. -->
  <PropertyGroup>
    <EnableFailpoints Condition="'$(EnableFailpoints)' == ''">false</EnableFailpoints>
  </PropertyGroup>

  <!-- Build identity: container builds pass -p:SourceRevisionId, -p:SourceBranch, -p:RepositoryUrl
       from build arguments (no .git folder in the build context). -->
  <ItemGroup>
    <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    <AssemblyMetadata Include="SourceBranch" Value="$(SourceBranch)" Condition="'$(SourceBranch)' != ''" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" Condition="'$(RepositoryUrl)' != ''" />
    <AssemblyMetadata Include="SourceTreeState" Value="$(SourceTreeState)" Condition="'$(SourceTreeState)' != ''" />
    <AssemblyMetadata Include="BuildFlavor" Value="$([MSBuild]::ValueOrDefault('$(BuildFlavor)', 'release'))" />
  </ItemGroup>
</Project>
