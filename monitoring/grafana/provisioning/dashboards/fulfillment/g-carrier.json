{
 "uid": "g-carrier",
 "title": "(g) Carrier callbacks and retries",
 "tags": [
  "fulfillment"
 ],
 "schemaVersion": 39,
 "editable": false,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Callbacks at the ingress by result",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(carrier_callbacks_total[1m]))",
     "legendFormat": "{{result}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Forward outcomes",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(carrier_forward_outcomes_total[1m]))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Forwards aging / dead-lettered at the carrier",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(carrier_forwards_aging)",
     "legendFormat": "forwards aging",
     "datasource": {
      "type": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(increase(carrier_callbacks_dead_lettered_total[5m]))",
     "legendFormat": "dead-lettered (5m)",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  }
 ]
}