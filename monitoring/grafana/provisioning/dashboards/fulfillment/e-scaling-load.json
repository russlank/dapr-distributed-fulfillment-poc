{
 "uid": "e-scaling-load",
 "title": "(e) Scaling and client-generated load",
 "tags": [
  "fulfillment"
 ],
 "schemaVersion": 39,
 "editable": false,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per service",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count[1m]))",
     "legendFormat": "{{exported_job}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Request latency p95 per service",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(http_server_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{exported_job}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Activity executions per replica (Dapr)",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(dapr_runtime_workflow_activity_execution_count[1m]))",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "CPU per service (s/s)",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (exported_job) (rate(dotnet_process_cpu_time_seconds_total[1m]))",
     "legendFormat": "{{exported_job}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Working set per service",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (exported_job) (dotnet_process_memory_working_set_bytes)",
     "legendFormat": "{{exported_job}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Thread pool queue per service",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
