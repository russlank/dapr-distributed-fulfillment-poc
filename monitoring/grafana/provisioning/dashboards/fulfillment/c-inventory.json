   "type": "timeseries",
   "title": "Inventory outbox",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(outbox_pending{source=\"inventory\"})",
